# ══════════════════════════════════════════════════════════════
# ImmoGest SaaS — Variables d'Environnement
# Copiez ce fichier en .env et adaptez les valeurs
# ══════════════════════════════════════════════════════════════

# ─── PostgreSQL ───────────────────────────────────────────────
POSTGRES_DB=immogest
POSTGRES_USER=immogest_user
POSTGRES_PASSWORD=ImmoGest@2025!
POSTGRES_PORT=5433

# ─── pgAdmin ──────────────────────────────────────────────────
PGADMIN_EMAIL=admin@immogest.com
PGADMIN_PASSWORD=Admin@2025!
PGADMIN_PORT=5050

# ─── API Backend ──────────────────────────────────────────────
API_PORT=5055
ASPNETCORE_ENVIRONMENT=Development

# ─── JWT ──────────────────────────────────────────────────────
# IMPORTANT: Changez cette clé en production (min. 32 caractères)
JWT_SECRET=ImmoGestSuperSecretKey2025!@#ChangeThisInProduction
JWT_ISSUER=ImmoGest
JWT_AUDIENCE=ImmoGestClients
JWT_EXPIRATION_HOURS=24

# ─── Frontend ─────────────────────────────────────────────────
FRONTEND_PORT=3000
FRONTEND_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:5055
NODE_ENV=development
