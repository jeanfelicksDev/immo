# Environment variables & local secrets
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.env

# Operating System Files
.DS_Store
Thumbs.db
desktop.ini

# IDE & Editor files
.vscode/
.idea/
*.swp
*.swo
*.suo
*.user
*.userosscache
*.sln.docstates

# Node / Next.js (Frontend)
frontend/node_modules/
frontend/.next/
frontend/out/
frontend/build/
frontend/.vercel
node_modules/

# .NET / C# (Backend)
backend/**/bin/
backend/**/obj/
backend/.vs/
*.user
*.userosscache
*.sln.docstates

# Database & Storage
database/*.db
database/*.sqlite
database/*.log

# Logs & Debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
logs/
*.log
